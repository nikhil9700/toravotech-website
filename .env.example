DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

DATABASE_URL=postgres://toravotech:toravotech@localhost:5432/toravotech

SITE_NAME=ToravoTech
SITE_URL=http://localhost:8000
SUPPORT_EMAIL=support@toravotech.com
DEFAULT_FROM_EMAIL=ToravoTech <noreply@toravotech.com>

# Local Mailpit
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Fernet key for encrypting collector secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FIELD_ENCRYPTION_KEY=

# AWS (app-side role that assumes customer roles) — leave blank for fixture mode
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TORAVOTECH_AWS_SERVICE_ROLE_ARN=

# Integrations
USE_FIXTURE_INTEGRATIONS=True
COLLECTOR_HMAC_MAX_SKEW_SECONDS=300
